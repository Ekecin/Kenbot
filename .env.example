# Copy this file to .env.local and fill in your own values.
# (.env also works, but never commit either one.)

# ───────── Google Gemini (text replies) ─────────
# Get a key at https://aistudio.google.com/apikey  (server only; never exposed to the browser)
GEMINI_API_KEY=your_gemini_key_here
# Text model. Gemini Flash is the default; change it here without touching code.
GEMINI_MODEL=gemini-3.6-flash
# Optional speed tuning. Less "thinking" means a faster first word.
#   Values: minimal | low | medium | high | default. Leave unset to use the built-in choice for your model.
#   (Gemini 3.7 and 3.8 Flash do not accept "minimal".)
# GEMINI_THINKING_VOICE=minimal
# GEMINI_THINKING_TEXT=low
# GEMINI_MAX_TOKENS_VOICE=600
# GEMINI_MAX_TOKENS_TEXT=2048

# ───────── Live internet access (Google Search grounding) ─────────
# KenBot searches the web when a question needs fresh information (news, scores, prices, "latest...").
# Needs a PAID Gemini API plan: 5,000 searches per month are included, then about $14 per 1,000.
# If your key can't use it, KenBot quietly carries on without search.
# Set to "off" to disable it.
WEB_SEARCH=on
# Daily search budgets (requests allowed to use search): per member, per guest address, and overall.
SEARCH_DAILY_MEMBER=100
SEARCH_DAILY_GUEST=10
SEARCH_DAILY_GLOBAL=1000
# How long to wait for Gemini to start answering before showing a "taking longer than usual" message.
# GEMINI_HEADER_TIMEOUT_MS=25000

# ───────── Setup self-check ─────────
# Open /api/health to see which settings are present, and /api/health?probe=all&token=YOUR_TOKEN
# to really test Gemini, web search, the neural voice and Supabase (with timings).
# In production the probe needs this token. Choose any long random text.
# HEALTH_TOKEN=choose-a-long-random-text

# ───────── Neural voice (Gemini text-to-speech) ─────────
# "gemini" = natural AI voice with the built-in browser voice as an automatic fallback.
# "browser" = only the built-in browser voice (free, quality depends on the device).
TTS_PROVIDER=gemini
# gemini-3.8-flash-lite-tts = fast and low cost (recommended for conversation).
# gemini-3.8-flash-tts = highest quality, and the only one that supports Igbo.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# KenBot's voice. Warm options: Sulafat (default), Achird (friendly), Vindemiatrix (gentle).
# You can also paste a voice ID from the Gemini voice library (for example a Nigerian-accent voice).
GEMINI_TTS_VOICE=Sulafat
# Optional: replace the short delivery style sent with every sentence.
# GEMINI_TTS_STYLE=warm, calm and friendly, like a relaxed conversation with a thoughtful friend

# Cost controls (characters of speech per day). Approximately 1,000 characters is 70 seconds of audio.
TTS_MAX_CHARS=500
TTS_DAILY_CHARS_MEMBER=30000
TTS_DAILY_CHARS_GUEST=3000
TTS_DAILY_CHARS_GLOBAL=600000
# Optional: override the built-in price estimates used in the usage log (US dollars per million tokens).
# TTS_PRICE_IN_PER_M=0.5
# TTS_PRICE_OUT_PER_M=6

# Show the voice timings panel and console tables in production too (always on in development).
# VOICE_DEBUG=1

# ───────── Supabase ─────────
# Project Settings -> API (or "API Keys"). Use the Project URL and the anon / publishable key.
# NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
