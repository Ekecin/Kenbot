# Copy this file to .env.local and fill in your own values.
# (.env also works, but never commit either one.)

# Google Gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# Optional: change the model without touching code.
GEMINI_MODEL=gemini-3.8-flash

# Supabase: Project Settings -> API (or "API Keys").
# Use the Project URL and the anon / publishable key.
# NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
